              "});\r",
              "\r",
              "pm.test(\"Response time is less than 2000ms\", () => {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
              "});\r",
              "\r",
              "pm.test(\"Content-Type is JSON\", () => {\r",
              "    pm.response.to.have.header(\r",
              "        \"Content-Type\",\r",
              "        \"application/json; charset=utf-8; v=1.0\"\r",
              "    );\r",
              "});\r",
              "\r",
              "pm.test(\"Response contains 'id' field\", () => {\r",
              "    pm.response.to.have.jsonBody(\"id\");\r",
              "});\r",
              "\r",
              "const jsonData = pm.response.json();\r",
              "\r",
              "pm.test(\"Response contains book details\", () => {\r",
              "    pm.expect(jsonData).to.have.property(\"title\");\r",
              "    pm.expect(jsonData.title).to.eql(\"Book 1\");\r",
              "\r",
              "    pm.expect(jsonData).to.have.property(\"id\");\r",
              "    pm.expect(jsonData.id).to.be.a(\"number\");\r",
              "\r",
              "    pm.expect(jsonData).to.have.property(\"description\");\r",
              "    pm.expect(jsonData.description).to.be.a(\"string\");\r",
              "\r",
              "    pm.expect(jsonData).to.have.property(\"pageCount\");\r",
              "    pm.expect(jsonData.pageCount).to.be.a(\"number\");\r",
              "\r",
              "    pm.expect(jsonData.pageCount).to.eql(100);\r",
              "\r",
              "    pm.expect(jsonData).to.have.property(\"excerpt\");\r",
              "    pm.expect(jsonData.excerpt).to.be.a(\"string\");\r",
              "\r",
              "    pm.expect(jsonData).to.have.property(\"publishDate\");\r",
              "    pm.expect(jsonData.publishDate).to.be.a(\"string\");\r",
              "});"
