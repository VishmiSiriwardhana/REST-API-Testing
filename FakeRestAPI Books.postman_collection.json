  "item": [
    {
      "name": "01 - Create Book",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const uniqueId = Math.floor(Math.random() * 900000) + 100000;\r",
              "\r",
              "pm.collectionVariables.set(\"generatedId\", uniqueId);\r",
              "\r",
              "console.log(\"Generated Book ID:\", uniqueId);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", () => {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Response time is less than 2000ms\", () => {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
              "});\r",
              "\r",
              "const jsonData = pm.response.json();\r",
              "\r",
              "pm.test(\"Response fields have correct data types\", () => {\r",
              "    pm.expect(jsonData).to.be.an(\"object\");\r",
              "    pm.expect(jsonData.id).to.be.a(\"number\");\r",
              "    pm.expect(jsonData.title).to.be.a(\"string\");\r",
              "    pm.expect(jsonData.description).to.be.a(\"string\");\r",
              "    pm.expect(jsonData.pageCount).to.be.a(\"number\");\r",
              "    pm.expect(jsonData.excerpt).to.be.a(\"string\");\r",
              "    pm.expect(jsonData.publishDate).to.be.a(\"string\");\r",
              "});\r",
              "\r",
              "pm.test(\"Generated ID is included in the response\", () => {\r",
              "    const generatedId = pm.collectionVariables.get(\"generatedId\");\r",
              "\r",
              "    pm.collectionVariables.set(\"bookID\", jsonData.id);\r",
              "\r",
              "    pm.expect(jsonData.id).to.eql(parseInt(generatedId));\r",
              "});\r",
              "\r",
              "pm.test(\"Book title matches\", () => {\r",
              "    pm.expect(jsonData.title).to.eql(\"Demo Book - API 1\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"id\": {{generatedId}},\r\n  \"title\": \"Demo Book - API 1\",\r\n  \"description\": \"This is a demo book\",\r\n  \"pageCount\": 200,\r\n  \"excerpt\": \"Test\",\r\n  \"publishDate\": \"2025-01-05T07:57:34.284Z\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{Base_URL}}/Books",
          "host": [
            "{{Base_URL}}"
          ],
          "path": [
            "Books"
          ]
        }
      },
      "response": []
    },
