    {
      "name": "03 - Get All Books",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", () => {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Response time is less than 2000ms\", () => {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
              "});\r",
              "\r",
              "pm.test(\"Content-Type is JSON\", () => {\r",
              "    pm.response.to.have.header(\r",
              "        \"Content-Type\",\r",
              "        \"application/json; charset=utf-8; v=1.0\"\r",
              "    );\r",
              "});\r",
              "\r",
              "const jsonData = pm.response.json();\r",
              "\r",
              "pm.test(\"Response is an array\", () => {\r",
              "    pm.expect(jsonData).to.be.an(\"array\");\r",
              "});\r",
              "\r",
              "pm.test(\"Response contains books\", () => {\r",
              "    pm.expect(jsonData.length).to.be.greaterThan(0);\r",
              "});\r",
              "\r",
              "pm.test(\"Each book contains required fields\", () => {\r",
              "    jsonData.forEach(book => {\r",
              "        pm.expect(book).to.have.property(\"id\");\r",
              "        pm.expect(book.id).to.be.a(\"number\");\r",
              "\r",
              "        pm.expect(book).to.have.property(\"title\");\r",
              "        pm.expect(book.title).to.be.a(\"string\");\r",
              "\r",
              "        pm.expect(book).to.have.property(\"description\");\r",
              "        pm.expect(book.description).to.be.a(\"string\");\r",
              "\r",
              "        pm.expect(book).to.have.property(\"pageCount\");\r",
              "        pm.expect(book.pageCount).to.be.a(\"number\");\r",
              "\r",
              "        pm.expect(book).to.have.property(\"excerpt\");\r",
              "        pm.expect(book.excerpt).to.be.a(\"string\");\r",
              "\r",
              "        pm.expect(book).to.have.property(\"publishDate\");\r",
              "        pm.expect(book.publishDate).to.be.a(\"string\");\r",
              "    });\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
